# PORT is read natively by Nitro's bun preset; do not add a "port" key to @lattice/env.
PORT=3001

# Generate with: bun run gateway generate-pepper
# Must be >= 32 characters. Losing this invalidates every issued Lattice API key.
API_KEY_PEPPER=

# Provider credentials. Only required for providers referenced by the model registry.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Self-hosted providers. No base URL means the provider isn't wired up at all. The api key is
# optional even when a base URL is set, since these typically run without authentication.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
VLLM_BASE_URL=
VLLM_API_KEY=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_SSL=
DB_DATABASE=
