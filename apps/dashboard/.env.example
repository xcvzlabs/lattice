# Generate via terminal: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=

# The gateway's base URL and a management API key minted with
# `bun run gateway seed-management-key <name>`. Server-side only — never exposed to the browser.
LATTICE_GATEWAY_URL=http://localhost:3001
LATTICE_MANAGEMENT_API_KEY=

# Dashboard's own database (better-auth sessions/users). Can be a separate database on the same
# Postgres server the gateway uses, or a different server entirely.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_SSL=
DB_DATABASE=
