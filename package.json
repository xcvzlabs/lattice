{
  "name": "lattice",
  "description": "Centralized AI infrastructure for connecting applications to cloud and self-hosted models",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "check": "bun run fmt && bun run fmt:check && bun run lint",
    "prepare": "husky",
    "stage": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose"
  },
  "workspaces": {
    "packages": [],
    "catalog": {
      "@types/bun": "1.4.0",
      "typescript": "7.0.2"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26.0.0"
  }
}
