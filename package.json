{
  "name": "lattice",
  "description": "Centralized AI infrastructure for connecting applications to cloud and self-hosted models",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "",
    "build": "",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p packages/env/tsconfig.json && tsc --noEmit -p packages/api-contract/tsconfig.json && tsc --noEmit -p apps/gateway/tsconfig.json",
    "check": "bun run fmt && bun run fmt:check && bun run lint",
    "prepare": "husky",
    "stage": "lint-staged",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "test:verbose": "bunx --bun vitest run --reporter=verbose",
    "gateway": "bun --filter gateway",
    "dashboard": "bun --filter dashboard"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "consola": "^3.4.2",
      "typescript": "7.0.2",
      "valibot": "^1.4.2"
    },
    "catalogs": {
      "client": {
        "@golar/vue": "^0.1.10",
        "@nuxt/ui": "^4.10.0",
        "@pinia/colada": "^1.4.2",
        "@pinia/colada-nuxt": "1.0.2",
        "@pinia/nuxt": "1.0.2",
        "@vueuse/nuxt": "14.4.0",
        "golar": "^0.1.10",
        "nuxt": "^4.5.2",
        "pinia": "^4.0.3",
        "pinia-plugin-persistedstate": "^4.7.1",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
      },
      "server": {
        "drizzle-kit": "^1.0.0-rc.4",
        "drizzle-orm": "^1.0.0-rc.4",
        "nitro": "^3.0.260610-beta"
      }
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:server",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^26.0.0"
  }
}
