{
  "name": "lattice",
  "description": "Centralized AI infrastructure for connecting applications to cloud and self-hosted models",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "",
    "build": "",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p packages/api-contract/tsconfig.json && tsc --noEmit -p apps/gateway/tsconfig.json && bun run dashboard typecheck",
    "check": "bun run fmt && bun run fmt:check && bun run lint",
    "prepare": "husky",
    "stage": "lint-staged",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "test:verbose": "bunx --bun vitest run --reporter=verbose",
    "gateway": "bun --cwd apps/gateway",
    "dashboard": "bun --cwd apps/dashboard",
    "docs": "bun --cwd apps/docs"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.4.3",
      "@xcvzlabs/env": "^0.1.2",
      "consola": "^3.4.2",
      "typescript": "7.0.2",
      "valibot": "^1.5.0"
    },
    "catalogs": {
      "client": {
        "@golar/vue": "^0.1.11",
        "@nuxt/ui": "^4.12.0",
        "@nuxtjs/better-auth": "0.3.10",
        "@pinia/colada": "^1.4.8",
        "@pinia/colada-nuxt": "1.2.0",
        "@pinia/nuxt": "1.0.3",
        "@vueuse/nuxt": "15.0.0",
        "better-auth": ">=1.7.0-rc.5 <2",
        "golar": "^0.1.10",
        "nuxt": "^4.6.2",
        "pinia": "^4.1.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0"
      },
      "server": {
        "drizzle-kit": "^1.0.0-rc.5-5935859",
        "drizzle-orm": "^1.0.0-rc.5-5935859",
        "nitro": "^3.0.260610-beta"
      }
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:server",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "bun@1.4.0"
}
