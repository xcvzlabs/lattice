{
  "name": "lattice",
  "description": "Centralized AI infrastructure for connecting applications to cloud and self-hosted models",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "check": "bun run fmt && bun run fmt:check && bun run lint"
  },
  "workspaces": {
    "packages": [],
    "catalog": {
      "@types/bun": "1.4.0",
      "typescript": "7.0.2"
    }
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "download"
    }
  }
}
